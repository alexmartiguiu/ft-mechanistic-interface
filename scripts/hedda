#!/usr/bin/env bash
# hedda — one-command launcher for the hedda demo stack.
#
#   hedda start          backend + frontend + ngrok, then open the public URL
#   hedda start -d       same, but detach (return to the shell; logs in .hedda/)
#   hedda start --build  serve the production build (vite preview) instead of dev
#   hedda stop           stop whatever THIS tool started (leaves reused procs alone)
#   hedda status         show component + tunnel state
#   hedda url            print the public ngrok URL
#   hedda open           (re)open the public URL in your browser
#   hedda logs [name]    tail logs (backend|frontend|ngrok; default: all)
#
# The stack: uvicorn (:8000)  ←  vite (:5173, proxies /api → backend)  ←  ngrok → https URL.
# ngrok forwards to the vite port, so ONE tunnel serves the UI and the proxied API.
# Robust to a wedged port: if :8000 (or :5173) is held by a dead/hung process it can't
# free, hedda falls back to the next free port and points vite's proxy (FTMI_API_PORT)
# at the backend it actually started. Already-healthy components are reused, never
# double-started. In a VS Code remote terminal the URL opens in your LOCAL browser
# via $BROWSER.
#
# Handy env overrides:
#   HEDDA_NGROK_DOMAIN   reserved ngrok domain to pin the URL (default below; set
#                        empty to let ngrok pick a random one each session)
#   HEDDA_BASIC_AUTH     user:pass to gate the public URL (default: none)
#   HEDDA_FRONTEND_PORT / HEDDA_BACKEND_PORT / HEDDA_PREVIEW_PORT
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cd "$REPO_ROOT"

RUN_DIR="$REPO_ROOT/.hedda"
mkdir -p "$RUN_DIR"

BACKEND_PORT="${HEDDA_BACKEND_PORT:-8000}"
DEV_PORT="${HEDDA_FRONTEND_PORT:-5173}"
PREVIEW_PORT="${HEDDA_PREVIEW_PORT:-4173}"
NGROK_API="http://127.0.0.1:4040/api/tunnels"
NGROK_BIN="${NGROK_BIN:-$HOME/bin/ngrok}"
# Pin the public URL to this account's reserved free domain so restarts keep the same
# link. It's a public hostname, not a secret. Set HEDDA_NGROK_DOMAIN= to disable.
HEDDA_NGROK_DOMAIN="${HEDDA_NGROK_DOMAIN-glitzy-mold-stained.ngrok-free.dev}"

# state discovered/chosen at runtime
BE_PORT=""; FE_PORT=""; NGROK_URL=""; BACKEND_NEW=0
STARTED=()

# ── pretty output ──
if [ -t 1 ]; then B=$'\e[1m'; D=$'\e[2m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; R=$'\e[31m'; X=$'\e[0m'
else B=; D=; G=; Y=; C=; R=; X=; fi
say()  { printf "%s %s\n" "${C}${B}hedda${X}" "$*"; }
warn() { printf "%s %s\n" "${Y}${B}hedda${X}" "$*" >&2; }
die()  { printf "%s %s\n" "${R}${B}hedda${X}" "$*" >&2; exit 1; }

have()      { command -v "$1" >/dev/null 2>&1; }
port_up()   { ss -ltn 2>/dev/null | grep -q ":$1 "; }
port_pid()  { ss -ltnp 2>/dev/null | grep ":$1 " | grep -oP 'pid=\K[0-9]+' | head -1; }
free_port() { local p="$1"; while port_up "$p"; do p=$((p+1)); done; echo "$p"; }
load_env()  { [ -f "$REPO_ROOT/.env" ] && { set -a; . "$REPO_ROOT/.env"; set +a; }; return 0; }
healthy_at() { curl -sf -m 4 "http://127.0.0.1:$1/api/health" >/dev/null 2>&1; }
ngrok_api_up() { curl -sf -m 5 "$NGROK_API" >/dev/null 2>&1; }

# Public https URL of the tunnel whose upstream is $1 (a port). Falls back to any https tunnel.
# NB: python3 -c (not `python3 - <<HEREDOC`) so curl's JSON stays on stdin instead of the script.
ngrok_url() {
  curl -sf -m 5 "$NGROK_API" 2>/dev/null | python3 -c '
import json, sys
want = sys.argv[1] if len(sys.argv) > 1 else ""
try:
    tunnels = json.load(sys.stdin).get("tunnels", [])
except Exception:
    sys.exit(0)
https = [t for t in tunnels if t.get("proto") == "https"]
for t in https:                       # prefer the tunnel pointing at our frontend port
    if want and want in t.get("config", {}).get("addr", ""):
        print(t["public_url"]); sys.exit(0)
if https:
    print(https[0]["public_url"])
' "${1:-}"
}

open_url() {
  local url="$1"
  # $BROWSER in a VS Code remote terminal → opens the LOCAL browser via the tunnel.
  if [ -n "${BROWSER:-}" ] && [ -x "${BROWSER%% *}" ]; then
    "$BROWSER" "$url" >/dev/null 2>&1 && return 0
  fi
  for o in xdg-open open wslview; do
    have "$o" && { "$o" "$url" >/dev/null 2>&1 && return 0; }
  done
  have code && code --openExternal "$url" >/dev/null 2>&1 && return 0
  return 1
}

uvicorn_cmd() {
  if [ -x "$REPO_ROOT/.venv/bin/uvicorn" ]; then echo "$REPO_ROOT/.venv/bin/uvicorn"
  elif [ -x "$REPO_ROOT/.venv/bin/python" ]; then echo "$REPO_ROOT/.venv/bin/python -m uvicorn"
  elif have uv; then echo "uv run --extra ui-backend -- uvicorn"
  else die "no uvicorn found (.venv or uv)"; fi
}

start_backend() {
  # 1) reuse a backend hedda started earlier (recorded port), if still healthy
  local rec; rec="$(cat "$RUN_DIR/backend.port" 2>/dev/null || true)"
  if [ -n "$rec" ] && healthy_at "$rec"; then
    BE_PORT="$rec"; say "backend   ${G}reuse${X}  :$BE_PORT ${D}(hedda-managed, healthy)${X}"; return 0
  fi
  # 2) reuse whatever is already healthy on the configured port
  if healthy_at "$BACKEND_PORT"; then
    BE_PORT="$BACKEND_PORT"; say "backend   ${G}reuse${X}  :$BE_PORT ${D}(already healthy)${X}"; return 0
  fi
  # 3) configured port busy but NOT answering health → wedged; step to next free port
  BE_PORT="$BACKEND_PORT"
  if port_up "$BACKEND_PORT"; then
    local pid; pid="$(port_pid "$BACKEND_PORT")"
    BE_PORT="$(free_port $((BACKEND_PORT + 1)))"
    warn ":$BACKEND_PORT is wedged (health fails, pid ${pid:-?}, can't free) — using :$BE_PORT instead"
  fi
  say "backend   ${Y}start${X}  :$BE_PORT"
  # shellcheck disable=SC2086
  ( cd "$REPO_ROOT" && exec $(uvicorn_cmd) ui_backend.main:app --host 0.0.0.0 --port "$BE_PORT" ) \
    >"$RUN_DIR/backend.log" 2>&1 &
  echo $! >"$RUN_DIR/backend.pid"; echo "$BE_PORT" >"$RUN_DIR/backend.port"
  STARTED+=("backend"); BACKEND_NEW=1
  local i=0; while [ "$i" -lt 40 ] && ! healthy_at "$BE_PORT"; do sleep 1; i=$((i+1)); done
  healthy_at "$BE_PORT" || warn "backend not healthy after 40s — see $RUN_DIR/backend.log"
}

start_frontend() {
  local mode="$1" base
  # reuse a frontend ONLY when the backend didn't change (else its /api proxy is stale)
  if [ "$BACKEND_NEW" -eq 0 ]; then
    local rec; rec="$(cat "$RUN_DIR/frontend.port" 2>/dev/null || true)"
    if [ -n "$rec" ] && port_up "$rec"; then
      FE_PORT="$rec"; say "frontend  ${G}reuse${X}  :$FE_PORT ${D}(hedda-managed)${X}"; return 0
    fi
    if [ "$BE_PORT" = 8000 ] && port_up "$DEV_PORT"; then
      FE_PORT="$DEV_PORT"; say "frontend  ${G}reuse${X}  :$FE_PORT ${D}(already listening → :8000)${X}"; return 0
    fi
  fi
  base=$([ "$mode" = build ] && echo "$PREVIEW_PORT" || echo "$DEV_PORT")
  FE_PORT="$(free_port "$base")"
  say "frontend  ${Y}start${X}  :$FE_PORT ${D}($mode, proxy /api → :$BE_PORT)${X}"
  if [ "$mode" = build ]; then
    ( cd "$REPO_ROOT/ui" && env FTMI_API_PORT="$BE_PORT" npm run build >"$RUN_DIR/frontend-build.log" 2>&1 \
        && exec env FTMI_API_PORT="$BE_PORT" npm run preview -- --port "$FE_PORT" --strictPort ) \
        >"$RUN_DIR/frontend.log" 2>&1 &
  else
    ( cd "$REPO_ROOT/ui" && exec env FTMI_API_PORT="$BE_PORT" npm run dev -- --port "$FE_PORT" --strictPort ) \
        >"$RUN_DIR/frontend.log" 2>&1 &
  fi
  echo $! >"$RUN_DIR/frontend.pid"; echo "$FE_PORT" >"$RUN_DIR/frontend.port"; STARTED+=("frontend")
  local i=0; while [ "$i" -lt 60 ] && ! port_up "$FE_PORT"; do sleep 1; i=$((i+1)); done
  port_up "$FE_PORT" || warn "frontend didn't bind :$FE_PORT in 60s — see $RUN_DIR/frontend.log"
}

start_ngrok() {
  local port="$1"
  if ngrok_api_up; then
    local url; url="$(ngrok_url "$port")"
    if [ -n "$url" ]; then NGROK_URL="$url"; say "ngrok     ${G}reuse${X}  $url ${D}(→ :$port)${X}"; return 0; fi
    warn "ngrok is up but not forwarding :$port — restarting it onto the right port"
    pkill -x ngrok 2>/dev/null; sleep 1
  fi
  [ -x "$NGROK_BIN" ] || die "ngrok not found at $NGROK_BIN (set NGROK_BIN=...)"
  local args=(http "$port" --log stdout)
  [ -n "$HEDDA_NGROK_DOMAIN" ] && args+=(--url "https://$HEDDA_NGROK_DOMAIN")
  [ -n "${HEDDA_BASIC_AUTH:-}" ] && args+=(--basic-auth "$HEDDA_BASIC_AUTH")
  say "ngrok     ${Y}start${X}  → :$port"
  ( exec "$NGROK_BIN" "${args[@]}" ) >"$RUN_DIR/ngrok.log" 2>&1 &
  echo $! >"$RUN_DIR/ngrok.pid"; STARTED+=("ngrok")
  local i=0; while [ "$i" -lt 20 ] && [ -z "$NGROK_URL" ]; do NGROK_URL="$(ngrok_url "$port")"; [ -n "$NGROK_URL" ] && break; sleep 1; i=$((i+1)); done
  [ -z "$NGROK_URL" ] && warn "couldn't read the ngrok URL in 20s — see $RUN_DIR/ngrok.log"
}

cleanup_started() {
  local c pid
  for c in "${STARTED[@]:-}"; do
    [ -n "$c" ] || continue
    pid="$(cat "$RUN_DIR/$c.pid" 2>/dev/null || true)"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null && say "stopped $c (pid $pid)"
    rm -f "$RUN_DIR/$c.pid"
  done
}

cmd_start() {
  local mode=dev detach=0
  for a in "$@"; do case "$a" in
    --build|-b)  mode=build ;;
    --dev)       mode=dev ;;
    -d|--detach) detach=1 ;;
    -h|--help)   usage; exit 0 ;;
    *) warn "unknown flag: $a" ;;
  esac; done

  load_env
  say "${B}bringing up the hedda stack${X} ${D}(mode: $mode)${X}"
  start_backend
  start_frontend "$mode"
  start_ngrok "$FE_PORT"

  echo
  if [ -n "$NGROK_URL" ]; then
    printf "  %s▸ live at  %s%s\n\n" "$G$B" "$NGROK_URL" "$X"
    if open_url "$NGROK_URL"; then say "opened in your browser ${D}(check the VS Code popup / your local browser)${X}"
    else warn "couldn't auto-open — copy the URL above into your browser"; fi
  else
    warn "no public URL — check 'hedda logs ngrok'"
  fi

  if [ "${#STARTED[@]}" -eq 0 ]; then
    say "everything was already running — nothing to babysit."; return 0
  fi
  if [ "$detach" -eq 1 ]; then
    say "detached. started: ${STARTED[*]}.  ${D}logs: hedda logs · stop: hedda stop${X}"; return 0
  fi
  trap 'echo; cleanup_started; exit 0' INT TERM
  say "${D}streaming logs for: ${STARTED[*]} — press Ctrl-C to stop them${X}"; echo
  local logs=(); for c in "${STARTED[@]}"; do logs+=("$RUN_DIR/$c.log"); done
  tail -n 2 -F "${logs[@]}" & wait "$!"
}

cmd_stop() {
  local any=0 c pid
  for c in ngrok frontend backend; do
    pid="$(cat "$RUN_DIR/$c.pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null && say "stopped $c (pid $pid)"; any=1
    fi
    rm -f "$RUN_DIR/$c.pid"
  done
  [ "$any" -eq 0 ] && say "nothing that hedda started is running."
  return 0
}

cmd_status() {
  load_env
  local rec; rec="$(cat "$RUN_DIR/backend.port" 2>/dev/null || true)"
  if [ -n "$rec" ] && healthy_at "$rec"; then say "backend   ${G}up${X}    :$rec"
  elif healthy_at "$BACKEND_PORT"; then say "backend   ${G}up${X}    :$BACKEND_PORT"
  else say "backend   ${R}down${X}"; fi
  local fe; fe="$(cat "$RUN_DIR/frontend.port" 2>/dev/null || true)"
  if [ -n "$fe" ] && port_up "$fe"; then say "frontend  ${G}up${X}    :$fe"
  elif port_up "$DEV_PORT"; then say "frontend  ${G}up${X}    :$DEV_PORT ${D}(dev)${X}"
  elif port_up "$PREVIEW_PORT"; then say "frontend  ${G}up${X}    :$PREVIEW_PORT ${D}(preview)${X}"
  else say "frontend  ${R}down${X}"; fi
  local url; url="$(ngrok_url "")"
  if [ -n "$url" ]; then say "ngrok     ${G}up${X}    $url"; else say "ngrok     ${R}down${X}"; fi
}

cmd_url()  { local u; u="$(ngrok_url "")"; [ -n "$u" ] && echo "$u" || { warn "no ngrok tunnel found"; exit 1; }; }
cmd_open() { local u; u="$(ngrok_url "")"; [ -z "$u" ] && die "no ngrok tunnel to open"; open_url "$u" && say "opened $u" || die "couldn't open $u"; }
cmd_logs() {
  local names=("$@"); [ "${#names[@]}" -eq 0 ] && names=(backend frontend ngrok)
  local files=(); for n in "${names[@]}"; do [ -f "$RUN_DIR/$n.log" ] && files+=("$RUN_DIR/$n.log"); done
  [ "${#files[@]}" -eq 0 ] && die "no logs yet (start something first)"
  tail -n 40 -F "${files[@]}"
}

# print the leading comment block (line 2 → first non-comment line), stripping "# ".
usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$(readlink -f "${BASH_SOURCE[0]}")"; }

case "${1:-start}" in
  start)  shift 2>/dev/null || true; cmd_start "$@" ;;
  stop)   cmd_stop ;;
  status|st) cmd_status ;;
  url)    cmd_url ;;
  open)   cmd_open ;;
  logs)   shift; cmd_logs "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown command '$1' — try: start | stop | status | url | open | logs" ;;
esac
