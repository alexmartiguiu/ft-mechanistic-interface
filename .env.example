# Copy to .env and fill in. Loaded for the API-backed steps; never commit .env.

# --- required for vector generation (artifact meta-prompt + response judge) ---
# Set the one matching --backend (anthropic default, or gemini). Both roles.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- required only for gated base models (e.g. Llama); Qwen is open ---
HF_TOKEN=

# --- optional ---
# Default model for generation/judge (overrides ftmi.llm.DEFAULT_MODEL).
FTMI_GEN_MODEL=claude-sonnet-4-6
# Experiment tracking, if used by the train loop.
WANDB_API_KEY=
